---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import rows from '../data/media.json';
import tags from '../data/media_tags.json';
---
<Base
  title="Media — Mike Todasco"
  description="Every podcast, radio and television appearance since 2018, including NPR Morning Edition, Wharton Business Daily and NBC 7 San Diego."
>
  <PageHeader
    num="07" sym="Me" name="Media" fam="misc" count="56"
    title="Talking into other people’s microphones"
    prose="Podcast, radio, and television appearances. Everything from NPR Morning Edition to a couple of guys with a microphone. Hours of good listening here!"
    links={[{ label: 'Book me', href: '/press' }, { label: 'Past appearances', href: '/media' }]}
    mike="mike-media"
    mikeAlt="Cartoon Mike Todasco in a podcast studio"
    right="Schedule · Lots of appearances"
  />

  <div class="filterbar">
    <div class="lbl">
      <b>Filter by subject</b>
      <span id="count">all 25 indexed — showing {rows.length} of {rows.length}</span>
    </div>
    <div class="chips" id="chips">
      <button class="chip" data-tag="All" aria-pressed="true" type="button">All</button>
      {tags.map((t) => <button class="chip" data-tag={t} aria-pressed="false" type="button">{t}</button>)}
    </div>
  </div>

  <div class="tbl">
    <div class="head mediarow">
      <span>Date</span><span>Outlet</span><span>Title</span><span>Subjects</span>
    </div>
    {rows.map((r) => (
      <a class="row mediarow" href={r.url || '#'} data-tags={r.tags.join('|')} target="_blank" rel="noopener">
        <span class="dt">{r.date}</span>
        <span class="ot">{r.outlet}</span>
        <span class="ti">{r.title}</span>
        <span class="tg">{r.tags.join(' · ')}</span>
      </a>
    ))}
  </div>

  <PageFooter
    left="Newest first. Every row links to the episode."
    right="Element 07 · Media"
    fam="misc"
  />
</Base>

<style>
  .mediarow { grid-template-columns: 74px 250px 1fr 260px; }
  .tbl .row .dt { font-family: var(--cd); font-size: 14px; font-weight: 600; color: var(--muted); padding-left: 4px; letter-spacing: .04em; }
  .tbl .row .ot { font-family: var(--cd); font-size: 16px; font-weight: 600; }
  .tbl .row .ti { font-size: 16px; line-height: 1.3; }
  .tbl .row .tg { font-family: var(--cd); font-size: 11.5px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); text-align: right; }
  .row[hidden] { display: none !important; }

  @media (max-width: 1100px) { .mediarow { grid-template-columns: 66px 200px 1fr; } .tbl .row .tg, .head span:last-child { display: none; } }
  @media (max-width: 700px) {
    .mediarow { grid-template-columns: 60px 1fr; gap: 8px; }
    .tbl .row .ti { grid-column: 2; }
    .tbl .head { display: none; }
  }
</style>

<script>
  const chips = document.getElementById('chips');
  const count = document.getElementById('count');
  const rows = [...document.querySelectorAll('.tbl .row')];

  chips?.addEventListener('click', (e) => {
    const btn = e.target.closest('.chip');
    if (!btn) return;
    const tag = btn.dataset.tag;
    chips.querySelectorAll('.chip').forEach((c) =>
      c.setAttribute('aria-pressed', String(c === btn)));
    let shown = 0;
    rows.forEach((r) => {
      const match = tag === 'All' || (r.dataset.tags || '').split('|').includes(tag);
      r.hidden = !match;
      if (match) shown++;
    });
    if (count) count.textContent = `all 25 indexed — showing ${shown} of ${rows.length}`;
  });
</script>
