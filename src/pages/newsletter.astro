---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import posts from '../data/newsletter.json';
import featured from '../data/featured.json';
import famData from '../data/essay-families.json';
import TalkCard from '../components/TalkCard.astro';
import SubscribeBlock from '../components/SubscribeBlock.astro';
import FamilyFilter from '../components/FamilyFilter.astro';
import StickySubscribe from '../components/StickySubscribe.astro';
import '../styles/families.css';

// two-letter symbol from the title, unique across the set
const STOP = new Set(['the','a','an','of','and','or','to','in','on','is','it','my','for','at','with','you','your','i']);
const used = new Set();
function symbolFor(title) {
  const words = title.replace(/[^A-Za-z0-9 ]/g, ' ').split(/\s+/).filter(Boolean);
  const strong = words.filter((w) => !STOP.has(w.toLowerCase()));
  const pool = strong.length ? strong : words;
  const cands = [];
  const first = pool[0] ?? 'Xx';
  if (pool[1]) cands.push(first[0].toUpperCase() + pool[1][0].toLowerCase());
  for (let i = 1; i < first.length; i++) cands.push(first[0].toUpperCase() + first[i].toLowerCase());
  for (const w of pool.slice(1)) cands.push(first[0].toUpperCase() + w[0].toLowerCase());
  for (const c of cands) if (!used.has(c)) { used.add(c); return c; }
  let n = 2;
  while (used.has(first[0].toUpperCase() + n)) n++;
  const f = first[0].toUpperCase() + n; used.add(f); return f;
}

// Display fixes for a few titles (data file keeps the originals).
const TITLE_FIX = {
  16: '“Writing” a Book with AI- My Foreword to Artificial America',
  24: 'Excerpt from ‘Sherlock Holmes and the Labyrinth of Choices’ Written by GPT-4',
  5: 'A Beginners Guide to No-Code AI Artwork Tools (Reviewing Craiyon, DALL-E, Midjourney, and Stable Diffusion)',
  68: 'Can AI Create a Comic Book? (2025)',
  77: 'AI Will Replace You, And That’s a Good Thing: Guest Post By “Evil Mike”',
};

// Family per essay comes from essay-families.json. A new essay needs one line there.
// Fail the build if one is missing so nothing ships unclassified.
const unfiled = posts.filter((p) => !famData.essays[String(p.n)]);
if (unfiled.length) throw new Error(`essay-families.json is missing: ${unfiled.map((p) => p.n).join(', ')}`);

// Symbols are assigned oldest-first so existing tiles never change when a new essay is added.
const withSym = [...posts].sort((a, b) => a.n - b.n).map((p) => {
  const fam = famData.essays[String(p.n)];
  return { ...p, title: TITLE_FIX[p.n] ?? p.title, sym: symbolFor(p.title), fam, code: famData.families[fam].code, famName: famData.families[fam].name };
});
const counts = {};
for (const p of withSym) counts[p.fam] = (counts[p.fam] || 0) + 1;

// Newest year first, newest essay first within each year.
const years = [...new Set(withSym.map((p) => p.year))].sort().reverse();
const rows = years.map((y) => ({
  year: y,
  items: withSym.filter((p) => p.year === y).sort((a, b) => b.n - a.n),
}));

// Pick one article per day. Consecutive days must not land on neighbours, so the
// date key gets avalanche-mixed rather than just multiplied — a plain h*31 hash
// walks the pool almost in order.
function dayIndex(key, len) {
  let h = 2166136261;
  for (let i = 0; i < key.length; i++) { h ^= key.charCodeAt(i); h = Math.imul(h, 16777619); }
  h ^= h >>> 15; h = Math.imul(h, 2246822507);
  h ^= h >>> 13; h = Math.imul(h, 3266489909);
  return ((h ^ (h >>> 16)) >>> 0) % len;
}
// Server-side default so the box is never empty. On a static build this is frozen
// at build time, so the client re-picks for the visitor's actual date.
const today = new Date();
const todayKey = `${today.getFullYear()}-${today.getMonth() + 1}-${today.getDate()}`;
const pick = featured[dayIndex(todayKey, featured.length)];
---
<Base
  title="The Newsletter — Mike Todasco"
  description={`Every essay from Artificially Intelligent Conversations, Mike Todasco's weekly AI newsletter — ${posts.length} of them, numbered from the first in August 2022.`}
>
  <div class="nlpage">
  <PageHeader
    num="01" sym="Ai" name="The Newsletter" fam="news" count="WEEKLY"
    title="Artificially Intelligent Conversations"
    prose={'Every essay since the first one in August 2022: &ldquo;The One Technology You SHOULD Freak Out About.&rdquo; Four years later, we&rsquo;re all freaking out.'}
    mike="mike-news"
    mikeAlt="Cartoon Mike Todasco writing late at night while two small robots look over his shoulder"
    right={`Complete index · ${posts.length} essays and counting`}
  />

  <TalkCard />
  <SubscribeBlock count={posts.length} />

  <div class="chartwrap">
    <aside class="featured" id="featured" data-pool={JSON.stringify(featured)}>
      <div class="flabel">Featured article</div>
      <a class="fcard" id="fcard" href={pick.url} target="_blank" rel="noopener">
        <div class="fart"><img id="fimg" src={pick.art.startsWith('https://') ? pick.art : `/img/${pick.art}.webp`} alt="" width="760" height="430" /></div>
        <div class="fmeta">
          <span class="fnum" id="fnum">#{pick.n}</span>
          <span class="ftitle" id="ftitle">{pick.title}</span>
          <span class="fgo">Read it &rarr;</span>
        </div>
      </a>
    </aside>

    <FamilyFilter counts={counts} total={posts.length} />

    <div class="index" data-filter="all">
      {rows.map(({ year, items }) => (
        <section class="period">
          <div class="ylabel"><b>{year}</b><span>{items.length}</span></div>
          <div class="row">
            {items.map((p) => (
              <a class="el" data-family={p.fam} href={p.url} target="_blank" rel="noopener" title={p.title} aria-label={`${p.title} (${p.famName}, essay ${p.n})`}>
                <span class="top"><span class="n">{p.n}</span><span class="famcode">{p.code}</span></span>
                <span class="sym">{p.sym}</span>
                <span class="t">{p.title}</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <PageFooter
    left="Numbered from the first one. Filter by family above."
    right="Element 01 · The Newsletter"
    fam="news"
  />
  <StickySubscribe />
  </div>
</Base>

<style>
  .chartwrap { padding: 22px 30px 28px; display: flex; flex-direction: column; gap: 18px; }
  .index { display: flex; flex-direction: column; gap: 14px; }

  .period { display: grid; grid-template-columns: 58px 1fr; gap: 14px; align-items: start; }
  .ylabel {
    display: flex; flex-direction: column; align-items: flex-end;
    padding-top: 4px; border-right: 2px solid var(--ink); padding-right: 12px;
  }
  .ylabel b { font-family: var(--bv); font-size: 26px; line-height: 1; font-weight: 400; }
  .ylabel span { font-family: var(--cd); font-size: 12px; font-weight: 600; letter-spacing: .12em; color: var(--muted); margin-top: 3px; }

  .row { display: grid; grid-template-columns: repeat(auto-fill, minmax(126px, 1fr)); gap: 5px; }

  .el {
    --tint: var(--news-pale); --ink2: var(--news);
    display: flex; flex-direction: column; gap: 3px;
    aspect-ratio: 1 / 1; padding: 8px 9px 9px;
    border: 2px solid var(--ink); background: var(--tint);
    overflow: hidden; transition: transform .1s ease, opacity .15s ease;
  }
  .el:hover { transform: translateY(-2px); color: inherit; }
  .el[data-family="big-picture"]  { --tint: var(--fam-big-picture-tint);  --ink2: var(--fam-big-picture-ink); }
  .el[data-family="models-tools"] { --tint: var(--fam-models-tools-tint); --ink2: var(--fam-models-tools-ink); }
  .el[data-family="creativity"]   { --tint: var(--fam-creativity-tint);   --ink2: var(--fam-creativity-ink); }
  .el[data-family="work-money"]   { --tint: var(--fam-work-money-tint);   --ink2: var(--fam-work-money-ink); }
  .el[data-family="trust-ethics"] { --tint: var(--fam-trust-ethics-tint); --ink2: var(--fam-trust-ethics-ink); }
  .el[data-family="movies"]       { --tint: var(--fam-movies-tint);       --ink2: var(--fam-movies-ink); }
  .el .top { display: flex; justify-content: space-between; align-items: baseline; }
  .el .n { font-family: var(--cd); font-size: 11px; font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums; }
  .el .famcode { font-family: var(--cd); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink2); }
  .el .sym { font-family: var(--bv); font-size: 30px; line-height: .92; color: var(--ink2); }
  .el .t {
    font-family: var(--cd); font-size: 11.5px; font-weight: 500; line-height: 1.16;
    letter-spacing: .01em; color: var(--ink); margin-top: auto;
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* chips dim non-matching tiles so the table keeps its shape */
  .index:not([data-filter="all"]) .el { opacity: .18; }
  .index[data-filter="big-picture"]  .el[data-family="big-picture"],
  .index[data-filter="models-tools"] .el[data-family="models-tools"],
  .index[data-filter="creativity"]   .el[data-family="creativity"],
  .index[data-filter="work-money"]   .el[data-family="work-money"],
  .index[data-filter="trust-ethics"] .el[data-family="trust-ethics"],
  .index[data-filter="movies"]       .el[data-family="movies"] { opacity: 1; }

  /* ── featured ─────────────────────────────────────────────── */
  .featured { border: 3px solid var(--paper-ink); background: var(--paper-pale); }
  .flabel {
    font-family: var(--cd); font-size: 11.5px; font-weight: 700; letter-spacing: .24em;
    text-transform: uppercase; color: #F2F6F9; background: var(--paper-ink);
    padding: 7px 12px;
  }
  .fcard { display: grid; grid-template-columns: 340px minmax(0, 1fr); }
  .fcard:hover { color: inherit; }
  .fcard:hover .fgo { border-bottom-color: var(--paper-ink); }
  .fart { border-right: 3px solid var(--paper-ink); background: var(--panel); aspect-ratio: 760 / 430; overflow: hidden; }
  .fart img { width: 100%; height: 100%; object-fit: cover; }
  .fmeta { padding: 13px 15px 16px; display: flex; flex-direction: column; justify-content: center; gap: 7px; }
  .fnum { font-family: var(--cd); font-size: 12px; font-weight: 700; letter-spacing: .1em; color: var(--paper-ink); }
  .ftitle { font-family: var(--bv); font-size: 24px; line-height: 1.15; }
  .fgo {
    font-family: var(--cd); font-size: 13px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: var(--paper-ink);
    border-bottom: 2px solid transparent; align-self: flex-start;
  }

  @media (max-width: 900px) {
    .chartwrap { padding: 14px; gap: 12px; }
    .fcard { grid-template-columns: 1fr; }
    .fart { border-right: 0; border-bottom: 3px solid var(--paper-ink); }
    .ftitle { font-size: 19px; }
    .index { gap: 10px; }
    /* year becomes a full-width header; 3 compact tiles per row */
    .period { grid-template-columns: 1fr; gap: 6px; }
    .ylabel { flex-direction: row; align-items: baseline; gap: 8px; border-right: 0; border-bottom: 2px solid var(--ink); padding: 0 0 3px; }
    .ylabel b { font-size: 20px; }
    .ylabel span { margin-top: 0; }
    .row { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 5px; }
    .el { aspect-ratio: auto; min-height: 104px; padding: 6px 7px 7px; }
    .el .sym { font-size: 24px; }
    .el .t { font-size: 10px; -webkit-line-clamp: 3; }
  }
</style>

<script>
  // Rotate the featured article once a day. Deterministic from the date, so
  // everyone sees the same one and it changes at midnight — no server needed.
  const box = document.getElementById('featured');
  if (box) {
    try {
      const pool = JSON.parse(box.dataset.pool || '[]');
      if (pool.length) {
        const d = new Date();
        const key = `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
        let h = 2166136261;
        for (let i = 0; i < key.length; i++) { h ^= key.charCodeAt(i); h = Math.imul(h, 16777619); }
        h ^= h >>> 15; h = Math.imul(h, 2246822507);
        h ^= h >>> 13; h = Math.imul(h, 3266489909);
        const p = pool[((h ^ (h >>> 16)) >>> 0) % pool.length];
        const card = document.getElementById('fcard');
        const img = document.getElementById('fimg');
        const num = document.getElementById('fnum');
        const title = document.getElementById('ftitle');
        if (card && img && num && title) {
          card.href = p.url;
          img.src = p.art.startsWith('https://') ? p.art : `/img/${p.art}.webp`;
          img.alt = '';
          num.textContent = `#${p.n}`;
          title.textContent = p.title;
        }
      }
    } catch { /* leave the server-rendered pick in place */ }
  }
</script>
