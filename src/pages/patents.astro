---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import patents from '../data/patents.json';
const recent = patents.slice(0, 5);
---
<Base
  title="Patents — Mike Todasco"
  description="120+ US patents from Mike Todasco's years leading innovation at PayPal — payments, machine learning, fraud, edge computing and a surprising amount of AR."
>
  <PageHeader
    num="06" sym="Pt" name="Patents" fam="paper-ink" count="120+"
    title="Lots of Crazy Ideas I Like To Talk About at Parties"
    prose="Patents from my time at PayPal from 2011-2022. Payments, machine learning, fraud, edge computing, and a surprising amount of augmented reality."
    links={[
      { label: 'Full list on Patent Leaderboard', href: 'https://www.patentleaderboard.com/paypal/michael-charles-todasco/9152' },
      { label: 'USPTO', href: 'https://ppubs.uspto.gov/pubwebapp/' },
    ]}
    mike="mike-patents"
    mikeAlt="Cartoon Mike Todasco in a lab coat beside a framed patent certificate"
    right="Live from Patent Leaderboard"
  />

  <section class="summary">
    <p class="lede">
      Mike Todasco holds <strong>120+ US patents</strong> from his years leading innovation at PayPal,
      spanning payments, machine learning, fraud detection, edge computing and augmented reality.
      The full, live-updated list is on his
      <a href="https://www.patentleaderboard.com/paypal/michael-charles-todasco/9152">Patent Leaderboard profile</a>.
    </p>
    <h2>Recent patents</h2>
    <ul>
      {recent.map((p) => <li><strong>{p.no}</strong> &mdash; {p.title}{" "}({p.date})</li>)}
    </ul>
  </section>

  <section class="embed">
    <iframe
      src="https://www.patentleaderboard.com/widget/inventor/9152"
      title="Patent Leaderboard — Michael Charles Todasco"
      loading="lazy"
      height="400"
    ></iframe>
  </section>

  <PageFooter
    left="Filing data from the USPTO, by way of Patent Leaderboard."
    right="Element 06 · Patents"
    fam="paper-ink"
  />
</Base>

<style>
  .summary { padding: 26px 30px 0; }
  .summary .lede { font-size: 18px; line-height: 1.55; margin: 0 0 18px; }
  .summary h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 10px; }
  .summary ul { margin: 0; padding-left: 20px; }
  .summary li { font-size: 15px; line-height: 1.5; margin-bottom: 6px; }
  .embed { padding: 26px 30px 30px; }
  .embed iframe { width: 100%; border: 3px solid var(--ink); background: #FAF7EF; display: block; }
  @media (max-width: 900px) { .summary { padding: 14px 14px 0; } .embed { padding: 14px; } }
</style>
