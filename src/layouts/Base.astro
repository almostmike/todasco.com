---
import '../styles/global.css';
import posts from '../data/newsletter.json';
import humorItems from '../data/humor.json';
import movieItems from '../data/movies.json';
import researchItems from '../data/research.json';
import mediaItems from '../data/media.json';
import builtItems from '../data/built.json';
import { ONE_LINE, PROFILES } from '../lib/llms';

const {
  title,
  description = "Mike Todasco writes children's books about science, humor for adults who think too much, and a weekly AI newsletter with zero hype.",
  page = '',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://todasco.com');
// build.format is 'file', so pathname arrives as /about.html. Netlify serves
// that same page at the extensionless /about, which is what every internal
// link and the sitemap use — so strip the extension to keep one canonical URL.
const path = Astro.url.pathname.replace(/(?:index)?\.html$/, '');
const canonical = new URL(path, site).href;
const ogImage = new URL('/img/og-default.jpg', site).href;

// ── Structured data ────────────────────────────────────────────────────────
// JSON-LD only: nothing below renders on the page. It gives search engines and
// AI assistants a machine-readable version of what each page already shows,
// built from the same data files, so it can't drift from the visible content.

const ME = 'https://todasco.com/#mike';
const WEBSITE = 'https://todasco.com/#website';
const slug = path.replace(/^\//, '');

const person = {
  '@type': 'Person',
  '@id': ME,
  name: 'Mike Todasco',
  alternateName: 'Michael Todasco',
  url: 'https://todasco.com/',
  image: ogImage,
  email: 'mailto:miketodasco@gmail.com',
  jobTitle: 'Author and Experimenter',
  description: ONE_LINE,
  knowsAbout: [
    'Artificial intelligence',
    'Generative AI',
    'Innovation',
    'Corporate innovation',
    'Payments',
    'Patents',
    'AI and creativity',
    'Humor writing',
    "Children's science books",
  ],
  hasOccupation: [
    { '@type': 'Occupation', name: 'Visiting Fellow', description: "Visiting Fellow at San Diego State University's James Silberrad Brown Center for Artificial Intelligence" },
    { '@type': 'Occupation', name: 'Writer', description: 'Author of the weekly AI newsletter Artificially Intelligent Conversations, humor, and children\'s books' },
  ],
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'San Diego State University',
    department: 'James Silberrad Brown Center for Artificial Intelligence',
  },
  alumniOf: [
    { '@type': 'Organization', name: 'PayPal', description: 'Led innovation; 119 US patents from that work' },
    { '@type': 'CollegeOrUniversity', name: 'Johns Hopkins University' },
    { '@type': 'CollegeOrUniversity', name: 'University of California, Berkeley' },
    { '@type': 'CollegeOrUniversity', name: 'University of Illinois Urbana-Champaign' },
  ],
  sameAs: PROFILES.map(([, u]) => u),
};

const website = {
  '@type': 'WebSite',
  '@id': WEBSITE,
  url: 'https://todasco.com/',
  name: 'Mike Todasco',
  description,
  inLanguage: 'en',
  publisher: { '@id': ME },
  author: { '@id': ME },
};

const cleanTitle = String(title).replace(/\s+—\s+Mike Todasco$/, '');
const crumbs = slug
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://todasco.com/' },
        { '@type': 'ListItem', position: 2, name: cleanTitle, item: canonical },
      ],
    }
  : null;

const byMe = { '@id': ME };
const itemList = (items) => ({
  '@type': 'ItemList',
  numberOfItems: items.length,
  itemListElement: items.map((item, i) => ({ '@type': 'ListItem', position: i + 1, item })),
});

// Page-specific content, keyed by path. Anything not listed gets a plain WebPage.
const pageExtras = {
  newsletter: () => ({
    '@type': 'Blog',
    name: 'Artificially Intelligent Conversations',
    description: "Mike Todasco's weekly AI newsletter.",
    author: byMe,
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.title,
      url: p.url,
      datePublished: p.date,
      author: byMe,
    })),
  }),
  research: () => itemList(researchItems.map((r) => ({
    '@type': 'ScholarlyArticle', name: `${r.short}: ${r.sub}`, url: r.url, author: byMe,
  }))),
  humor: () => itemList(humorItems.map((h) => ({
    '@type': 'CreativeWork', name: h.title, url: h.url, datePublished: h.date, author: byMe,
    ...(h.outlet ? { publisher: { '@type': 'Organization', name: h.outlet } } : {}),
  }))),
  'ai-at-the-movies': () => itemList(movieItems.map((m) => ({
    '@type': 'Article', name: `${m.film}: ${m.sub}`, url: m.url, author: byMe,
    about: { '@type': 'Movie', name: m.film },
  }))),
  media: () => itemList(mediaItems.filter((m) => m.url).map((m) => ({
    '@type': 'CreativeWork', name: m.title, url: m.url,
    publisher: { '@type': 'Organization', name: m.outlet }, contributor: byMe,
  }))),
  built: () => itemList(builtItems.map((b) => ({
    '@type': 'WebSite', name: b.name, url: b.url, description: b.desc, creator: byMe,
  }))),
  'periodic-fables': () => ({
    '@type': 'BookSeries',
    name: 'Periodic Fables',
    description: 'A series of stand-alone graphic novels where atoms take readers on adventures through science.',
    author: byMe,
    publisher: { '@type': 'Organization', name: 'Paw Prints Publishing', url: 'https://pawprintspublishing.com' },
    genre: ["Children's graphic novel", 'Science'],
  }),
};

const graph = [];
if (!noindex) {
  if (page === 'home') {
    graph.push(person, website);
  } else if (page === 'about') {
    graph.push({
      '@type': 'ProfilePage',
      '@id': canonical,
      url: canonical,
      name: cleanTitle,
      description,
      isPartOf: { '@id': WEBSITE },
      mainEntity: person,
    });
  } else {
    const extra = pageExtras[slug]?.();
    graph.push({
      '@type': slug === 'press' ? 'AboutPage' : extra && extra['@type'] === 'ItemList' ? 'CollectionPage' : 'WebPage',
      '@id': canonical,
      url: canonical,
      name: cleanTitle,
      description,
      isPartOf: { '@id': WEBSITE },
      about: slug === 'press' ? byMe : undefined,
      author: byMe,
      ...(extra ? { mainEntity: extra } : {}),
    });
  }
  // Every page carries the full Person node so each one resolves on its own.
  if (page !== 'home' && page !== 'about') graph.push(person);
  if (crumbs) graph.push(crumbs);
}
// `<` is escaped so no string in the data can close the script tag early.
const jsonLd = graph.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')
  : '';
---
<!doctype html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GZSZ43GV3D"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-GZSZ43GV3D');
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {/* noindex={true} keeps links followable; a string sets the exact directive */}
  {noindex && <meta name="robots" content={typeof noindex === 'string' ? noindex : 'noindex, follow'} />}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Mike Todasco" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Mike Todasco — author, inventor, experimenter" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:creator" content="@todasco" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#EAE6DC" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Bevan&family=Barlow+Condensed:wght@400;500;600;700&family=Barlow:wght@300;400;500;600&display=swap"
  />

  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="sheet-outer">
    <main id="main" class="sheet">
      <slot />
    </main>
  </div>
</body>
</html>
