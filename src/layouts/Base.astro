---
import '../styles/global.css';

const {
  title,
  description = "Mike Todasco writes children's books about science, humor for adults who think too much, and a weekly AI newsletter with zero hype.",
  page = '',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://todasco.com');
// build.format is 'file', so pathname arrives as /about.html. Netlify serves
// that same page at the extensionless /about, which is what every internal
// link and the sitemap use — so strip the extension to keep one canonical URL.
const path = Astro.url.pathname.replace(/(?:index)?\.html$/, '');
const canonical = new URL(path, site).href;
const ogImage = new URL('/img/og-default.jpg', site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Mike Todasco" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Mike Todasco — author, inventor, experimenter" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:creator" content="@todasco" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#EAE6DC" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Bevan&family=Barlow+Condensed:wght@400;500;600;700&family=Barlow:wght@300;400;500;600&display=swap"
  />

  {/* Person is the entity this whole site is about. Emitted on the home page and
      on /about, which is the page that actually describes him — the two places a
      search engine or an assistant would look to resolve "who is Mike Todasco". */}
  {(page === 'home' || page === 'about') && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      '@id': 'https://todasco.com/#mike',
      name: 'Mike Todasco',
      alternateName: 'Michael Todasco',
      url: 'https://todasco.com/',
      mainEntityOfPage: canonical,
      image: ogImage,
      jobTitle: 'Author and Experimenter',
      description,
      knowsAbout: [
        'Artificial intelligence',
        'Generative AI',
        'Innovation',
        'Payments',
        'Patents',
        "Children's science books",
      ],
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: 'San Diego State University',
        department: 'James Silberrad Brown Center for Artificial Intelligence',
      },
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'Johns Hopkins University' },
        { '@type': 'CollegeOrUniversity', name: 'University of California, Berkeley' },
        { '@type': 'CollegeOrUniversity', name: 'University of Illinois Urbana-Champaign' },
      ],
      sameAs: [
        'https://todasco.substack.com',
        'https://medium.com/@todasco',
        'https://www.linkedin.com/in/todasco/',
        'https://bsky.app/profile/todasco.bsky.social',
        'https://x.com/todasco',
        'https://scholar.google.com/citations?user=LtLp_AoAAAAJ',
        'https://papers.ssrn.com/Sol3/Cf_Dev/AbsByAuth.cfm?per_id=10493676',
      ],
    })} />
  )}

  {page === 'home' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': 'https://todasco.com/#website',
      url: 'https://todasco.com/',
      name: 'Mike Todasco',
      description,
      inLanguage: 'en',
      publisher: { '@id': 'https://todasco.com/#mike' },
    })} />
  )}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="sheet-outer">
    <main id="main" class="sheet">
      <slot />
    </main>
  </div>
</body>
</html>
