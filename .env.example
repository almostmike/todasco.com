# Copy to .env and fill in. .env is gitignored — it never leaves your machine.
# These same two values must also be set in your host's dashboard (Netlify:
# Site configuration → Environment variables), because /jobs reads Notion on
# every request in production.

# Notion → Developer tools → Personal access tokens → ··· → Copy token.
# Use a token dedicated to the website, so revoking it can't break the
# browser extension that writes to the same database.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Mike's Jobs database.
NOTION_DATABASE_ID=30a34c404e5a803fb2b3f4ef689c5f1f

# Optional Firewalla family time board. Set these in Netlify's environment
# variables as well; none of these values belongs in the browser bundle.
FIREWALLA_MSP_DOMAIN=your-msp.firewalla.net
FIREWALLA_API_TOKEN=your-personal-access-token
FIREWALLA_BOX_GID=your-box-gid
FIREWALLA_CONNOR_USER_ID=your-connor-user-id
FIREWALLA_SYDNEY_USER_ID=your-sydney-user-id
HUB_SYNC_TOKEN=generate-a-long-random-secret-and-use-it-in-the-hub-admin
